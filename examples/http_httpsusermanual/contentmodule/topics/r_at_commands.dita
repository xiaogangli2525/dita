        <section id="section_bch_41t_yqb">
            <title/>
            <note id="note_r1y_p1t_yqb"
                ><?oxy_comment_start author="zhouziwei@cmiot.cmcc" timestamp="20211012T161831+0800" comment="建议该部分内容调整为脚注，请告知应标注的正确位置"?>1、模组默认报头中，普通模式包含Host、Content-Length字段，<?oxy_comment_start author="zhouziwei@cmiot.cmcc" timestamp="20211012T170456+0800" comment="大小写用法与前文不一致"?>chunked<?oxy_comment_end?>模式包含Host、Transfer-Encoding字段。</note>
            <note id="note_nql_51t_yqb">2、报头设置可通过两条<?oxy_insert_start author="zhouziwei@cmiot.cmcc" timestamp="20211012T170513+0800"?>命<?oxy_insert_end?><?oxy_delete author="zhouziwei@cmiot.cmcc" timestamp="20211012T170512+0800" content="指"?>令实现，AT+MHTTPCFG="header"<?oxy_insert_start author="zhouziwei@cmiot.cmcc" timestamp="20211012T170519+0800"?>
                <?oxy_insert_end?>用于设置通用报头，应用于实例生命周期<?oxy_delete author="zhouziwei@cmiot.cmcc" timestamp="20211012T170524+0800" content="，"?><?oxy_insert_start author="zhouziwei@cmiot.cmcc" timestamp="20211012T170524+0800"?>；<?oxy_insert_end?>AT+MHTTPHEADER<?oxy_insert_start author="zhouziwei@cmiot.cmcc" timestamp="20211012T170528+0800"?>
                <?oxy_insert_end?>用于设置特定报头，单次请求有效，主要用于在不同请求时设置变化的字段<?oxy_insert_start author="zhouziwei@cmiot.cmcc" timestamp="20211012T170547+0800"?>。<?oxy_insert_end?><?oxy_delete author="zhouziwei@cmiot.cmcc" timestamp="20211012T170547+0800" content="，"?>如果通用报头中存在特定报头相同字段，模组将在发送请求时自动替换为特定报头设置值。<?oxy_comment_end?></note>
