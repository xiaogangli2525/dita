        <section id="section_rw1_xyg_grb">
            <msgblock id="msgblock_axm_xyg_grb">/*创建http实例，可指定URL，除HTTP标识和域名外，其他URL部分将被忽略。*/
<cmdname>AT+HTTPCREATE="http://iot.10086.cn/"</cmdname>
+HTTPCREATE:0    /*模组返回httpclient id:0*/
OK

/*配置HTTP头部，注意HTTP协议规定每个头部字段之间有回车换行分隔，部分HTTP服务器要求配置User-Agent字段，不然会拒绝响应。*/
<cmdname>AT+HTTPHEADER=0,"User-Agent: Unkown\r\nConnection: close\r\n"</cmdname>
OK

/*发送GET(method参数为0)请求包，URL资源绝对路径“/page/index/name/culture”。*/
<cmdname>AT+HTTPSEND=0,0,"/page/index/name/culture"</cmdname>    
OK    /*模组收到发送请求*/
CONNECT OK    /*连接服务器成功*/
