<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="reference_qd5_gdq_cqb">
    <title><?oxy_comment_start author="zhangqin1@cmiot.cmcc" timestamp="20241101T141753+0800" comment="该内容模块为基础版本共用，请勿随意删减。若需添加仅适用于某型号的内容，请添加批注说明"?>AT+HTTPSEND<?oxy_comment_end?></title>
    <shortdesc>该命令发送HTTP请求。</shortdesc>
    <refbody>
        <table id="table_btl_krz_3qb">
            <tgroup cols="2">
                <colspec colname="c1" colnum="1" colwidth="3*" align="left"/>
                <colspec colname="c2" colnum="2" colwidth="7*" align="left"/>
                <thead>
                    <row>
                        <entry namest="c1" nameend="c2"><cmdname>AT+HTTPSEND</cmdname></entry>
                    </row>
                </thead>
                <tbody>
                    <row outputclass="has_bgc">
                        <entry>语法</entry>
                        <entry>响应</entry>
                    </row>
                    <row>
                        <entry>设置命令<codeblock><cmdname>AT+HTTPSEND=&lt;id>,&lt;method>,&lt;path></cmdname></codeblock></entry>
                        <entry>成功<div>如果输入格式正确返回：</div><msgblock id="msgblock_xmq_xb5_pqb">OK</msgblock>失败<msgblock id="msgblock_cv3_cj3_ncc">ERROR</msgblock></entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">命令描述</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">该命令发送HTTP请求。</entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">参数描述</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                                ><varname>&lt;id></varname>整型，通过<msgph>+HTTPCREATE</msgph>返回的实例索引，范围：0~4。<fn>M5310-E/MN328-B范围：0~1。</fn></entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                            ><varname>&lt;method></varname>整型，HTTP请求类型。</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">
                            <dl>
                                <dlentry>
                                    <dt>0</dt>
                                    <dd>GET</dd>
                                </dlentry>
                                <dlentry>
                                    <dt>1</dt>
                                    <dd>POST</dd>
                                </dlentry>
                                <dlentry>
                                    <dt>2</dt>
                                    <dd>PUT</dd>
                                </dlentry>
                                <dlentry>
                                    <dt>3</dt>
                                    <dd>DELETE</dd>
                                </dlentry>
                                <dlentry>
                                    <dt>4</dt>
                                    <dd>HEAD</dd>
                                </dlentry>
                            </dl>
                        </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"><varname>&lt;path></varname>字符串，请求的URL
                            path绝对路径参数。</entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">示例</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                            >创建实例<div>IPv4:</div><msgblock id="codeblock_l2w_nfj_1rb"><cmdname>AT+HTTPSEND=0,0,"/page/index/name/zhangcheng"</cmdname>
OK
CONNECT OK
+HTTPNMIH:0,1,443
Server: Tengine
Content-Type: image/svg+xml
Transfer-Encoding: chunked
Connection: keep-alive
……
+HTTPNMIH:0,0,435
age-class: Standard
