……
+HTTPNMIC:0,1,927,21
……
+HTTPNMIC:0,1,937,10
……
+HTTPNMIC:0,0,937,0
……</msgblock>IPv6:<msgblock id="msgblock_lyx_hgr_ldc"><cmdname>AT+MDNSCFG="priority",1</cmdname>
OK
<cmdname>AT+HTTPCREATE="www.cmiot.store"</cmdname>
+HTTPCREATE:0
OK
<cmdname>AT+HTTPSEND=0,0,"/get"</cmdname>
