<reference id="reference_qd5_gdq_cqb">
    <title><?oxy_comment_start author="zhangqin1@cmiot.cmcc" timestamp="20241101T141807+0800" comment="该内容模块为基础版本共用，请勿随意删减。若需添加仅适用于某型号的内容，请添加批注说明"?>AT+HTTPCLOSE<?oxy_comment_end?></title>
    <shortdesc>该命令用于关闭HTTP实例。</shortdesc>
    <refbody>
        <table id="table_btl_krz_3qb">
            <tgroup cols="2">
                <colspec colname="c1" colnum="1" colwidth="3*" align="left"/>
                <colspec colname="c2" colnum="2" colwidth="7*" align="left"/>
                <thead>
                    <row>
                        <entry namest="c1" nameend="c2"><cmdname>AT+HTTPCLOSE</cmdname></entry>
                    </row>
                </thead>
                <tbody>
                    <row outputclass="has_bgc">
                        <entry>语法</entry>
                        <entry>响应</entry>
                    </row>
                    <row>
                        <entry>设置命令<codeblock><cmdname>AT+HTTPCLOSE=&lt;id></cmdname></codeblock></entry>
                        <entry>成功<div>如果输入设置格式正确，且成功关闭，返回：</div><msgblock id="msgblock_xmq_xb5_pqb">OK</msgblock>
                            失败<msgblock id="msgblock_yhd_2j3_ncc">ERROR</msgblock></entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">命令描述</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">该命令用于关闭HTTP实例。</entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">参数描述</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                                ><varname>&lt;id></varname>整型，通过<msgph>+HTTPCREATE</msgph>返回的实例索引，范围：0~4。<fn>M5310-E/MN328-B范围：0~1。</fn></entry>
                    </row>
                </tbody>
            </tgroup>
        </table>
    </refbody>
