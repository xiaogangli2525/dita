<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="reference_ghr_ndq_cqb">
    <title>AT+MHTTPREAD 读取HTTP数据</title>
    <shortdesc>该命令用于读取缓存模式下的HTTP缓存数据。</shortdesc>
    <refbody>
        <table id="table_kxd_xfc_jqb">
            <tgroup cols="2">
                <colspec colname="c1" colnum="1" colwidth="3*" align="left"/>
                <colspec colname="c2" colnum="2" colwidth="7*" align="left"/>
                <thead>
                    <row>
                        <entry namest="c1" nameend="c2"><cmdname>AT+MHTTPREAD</cmdname></entry>
                    </row>
                </thead>
                <tbody>
                    <row outputclass="has_bgc">
                        <entry>语法</entry>
                        <entry>响应</entry>
                    </row>
                    <row>
                        <entry>测试命令<codeblock outputclass="language-c"><cmdname>AT+MHTTPREAD=?</cmdname></codeblock></entry>
                        <entry>
                            成功<msgblock id="msgblock_fdb_p25_pqb">AT+MHTTPREAD: (list of supported&lt;httpid>s),(list of supported&lt;type>s),(list of supported&lt;read_len>s)
OK</msgblock>
                            失败<msgblock id="msgblock_t12_p25_pqb">+CME ERROR: &lt;err></msgblock></entry>
                    </row>
                    <row>
                        <entry>设置命令<codeblock outputclass="language-c"><cmdname>AT+MHTTPREAD=&lt;httpid>,&lt;type>[,&lt;read_len>]</cmdname></codeblock></entry>
                        <entry> 成功 <p><varname>&lt;read_len></varname>不设置时，返回当前可读缓存长度： </p><msgblock id="msgblock_vcs_p25_pqb">+MHTTPREAD: &lt;httpid>,&lt;type>,&lt;unread_length>
OK</msgblock>
                            <p><varname>&lt;read_len></varname>设置时，返回数据：</p>
                            <msgblock id="msgblock_hfw_p25_pqb">+MHTTPREAD: &lt;httpid>,&lt;type>,&lt;unread_length>,&lt;data_len>,&lt;data>
OK</msgblock> 错误
                            <msgblock id="msgblock_qkg_q25_pqb">+CME ERROR: &lt;err></msgblock></entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">命令描述</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">缓存模式下，接收到的数据将缓存至模组中，<cmdname>+MHTTPURC:
                                "recv"</cmdname>提示后表示请求结束，可使用该命令读取数据，读取后自动清空，如果未及时读取，下次请求或者删除实例时也将自动清空。</entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">参数描述</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"><varname>&lt;httpid></varname>
                            客户端实例id，0~3。</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"><varname>&lt;type></varname> 缓存数据类型</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">
                            <parml id="parml_q4s_htz_frb">
                                <plentry>
                                    <pt>0</pt>
                                    <pd>header数据</pd>
                                </plentry>
                                <plentry>
                                    <pt>1</pt>
                                    <pd>content数据</pd>
                                </plentry>
                            </parml>
                        </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"><varname>&lt;read_len></varname>
                            希望读取的数据长度，0~65535，为0时读取全部缓存数据。</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"><varname>&lt;unread_length></varname>
                            剩余未读取缓存长度。</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"><varname>&lt;data_len></varname>
                            当前读取数据长度。</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"><varname>&lt;data></varname> 读取的数据。</entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">示例</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">读取缓存数据
                            <msgblock id="codeblock_lp4_jwj_1rb"><cmdname>AT+MHTTPCREATE="http://120.27.12.119:10080"</cmdname>
+MHTTPCREATE: 0
OK
<cmdname>AT+MHTTPCFG="cached",0,1</cmdname>
OK
<cmdname>AT+MHTTPREQUEST=0,1,0,"/get"</cmdname>
OK
+MHTTPURC: "recv",0,200,225,145
<cmdname>AT+MHTTPREAD=0,0,225</cmdname>
+MHTTPREAD: 0,0,0,225,HTTP/1.1 200 OK
Server: nginx/1.18.0
Date: Mon, 26 Jul 2021 01:25:15 GMT
Content-Type: application/json
Content-Length: 145
Connection: keep-alive
Access-Control-Allow-Origin: *
Access-Control-Allow-Credentials: true
OK</msgblock></entry>
                    </row>
                </tbody>
            </tgroup>
        </table>
    </refbody>
</reference>

