                    </row>
                </thead>
                <tbody>
                    <row>
                        <entry>设置 HTTP服务器 URL</entry>
                        <entry>AT^HTTPURL=20,80</entry>
                        <entry>CONNECT</entry>
                    </row>
                    <row>
                        <entry>输入 URL</entry>
                        <entry>http://www.baidu.com</entry>
                        <entry>OK</entry>
                    </row>
                    <row>
                        <entry>发送 GET 请求到 HTTP服务器</entry>
                        <entry>AT^HTTPGET=80</entry>
                        <entry>^HTTPGET: 0,200,19825</entry>
                    </row>
                </tbody>
            </tgroup>
        </table>
