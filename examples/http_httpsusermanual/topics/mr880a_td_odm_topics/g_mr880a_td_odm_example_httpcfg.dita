<!DOCTYPE topic
  PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="ZH-CN_TOPIC_0000002224627345-chtext">
        <title>示例</title>
        <body>
          <table colsep="1" frame="all" rowsep="1">
            <tgroup cols="3">
              <colspec colname="col1" colnum="1" colwidth="0.7*"/>
              <colspec colname="col2" colnum="2" colwidth="1.3*"/>
              <colspec colname="col3" colnum="3" colwidth="1*"/>
              <thead>
                <row>
                  <entry>示例</entry>
                  <entry>输入</entry>
                  <entry>输出</entry>
                </row>
              </thead>
              <tbody>
                <row>
                  <entry>配置PDP上下文ID为1</entry>
                  <entry>AT^HTTPCFG="contextid",1</entry>
                  <entry>OK</entry>
                </row>
                <row>
                  <entry>启用输出 HTTP
响应头信息</entry>
                  <entry>AT^HTTPCFG="responseheader",1</entry>
                  <entry>OK</entry>
                </row>
                <row>
                  <entry>查询HTTP服务器参数</entry>
                  <entry>AT^HTTPCFG?</entry>
                  <entry>
                    <div>^HTTPCFG: contextid,1</div>
                    <div>^HTTPCFG: requestheader,0</div>
                    <div>^HTTPCFG: responseheader,0</div>
                    <div>^HTTPCFG: sslctxid,1</div>
                    <div>^HTTPCFG: contenttype,0</div>
                    <div>^HTTPCFG: rspout/auto,0</div>
                    <div>^HTTPCFG: "recvmode",0</div>
                    <div>OK</div>
                  </entry>
                </row>
                <row>
                  <entry>
设置响应头信息（参数错误）</entry>
                  <entry>AT^HTTPCFG="response_header",2</entry>
                  <entry>ERROR</entry>
                </row>
              </tbody>
            </tgroup>
          </table>
        </body>
      </topic>
