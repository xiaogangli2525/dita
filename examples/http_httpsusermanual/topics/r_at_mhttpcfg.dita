<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="reference_fvd_fy4_cqb">
    <title>AT+MHTTPCFG 参数设置</title>
    <shortdesc>该命令用于设置客户端实例相关的通用配置参数。</shortdesc>
    <refbody>
        <table id="table_pvb_kbv_3qb">
            <tgroup cols="2">
                <colspec colname="c1" colnum="1" colwidth="3*" align="left"/>
                <colspec colname="c2" colnum="2" colwidth="7*" align="left"/>
                <thead>
                    <row>
                        <entry namest="c1" nameend="c2"><cmdname>AT+MHTTPCFG</cmdname></entry>
                    </row>
                </thead>
                <tbody>
                    <row outputclass="has_bgc">
                        <entry>语法</entry>
                        <entry>响应</entry>
                    </row>
                    <row>
                        <entry>测试命令<codeblock><cmdname>AT+MHTTPCFG=?</cmdname></codeblock></entry>
                        <entry>成功<msgblock id="msgblock_xcs_nyt_pqb">+MHTTPCFG: (list of supported &lt;cmd>s),(list of supported &lt;httpid>s),
OK</msgblock>
                            错误<msgblock id="msgblock_pgq_pyt_pqb">+CME ERROR: &lt;err></msgblock></entry>
                    </row>
                    <row>
                        <entry>读取命令<codeblock><cmdname>AT+MHTTPCFG?</cmdname></codeblock></entry>
                        <entry>成功<msgblock id="msgblock_ln5_fzt_pqb">[+MHTTPCFG: "header",&lt;httpid>[,&lt;header_len>,&lt;header>]
+MHTTPCFG: "chunked",&lt;httpid>,&lt;chunked_mode>
+MHTTPCFG: "cached",&lt;httpid>,&lt;cached>[,&lt;cache_length>]
+MHTTPCFG: "timeout",&lt;httpid>,&lt;conn_timeout>,&lt;rsp_timeout>,&lt;input_timeout>
+MHTTPCFG: "encoding",&lt;httpid>,&lt;input_format>,&lt;output_format>
+MHTTPCFG: "ssl",&lt;httpid>,&lt;ssl_enable>[,&lt;ssl_id>]
+MHTTPCFG: "cid",&lt;httpid>[,&lt;cid>]
+MHTTPCFG: "fragment",&lt;httpid>,&lt;frag_size>,&lt;interval>
+MHTTPCFG: "urlencode",&lt;httpid>,&lt;urlencode_mode>
[...]]
OK</msgblock> 错误
                            <msgblock id="msgblock_v25_hzt_pqb">+CME ERROR: &lt;err></msgblock>
                        </entry>
                    </row>
                    <row>
                        <entry>设置命令（通用报头设置）<codeblock><cmdname>AT+MHTTPCFG="header"[,&lt;httpid>[,&lt;header>]]</cmdname></codeblock></entry>
                        <entry>成功<div><varname>&lt;httpid></varname>和<varname>&lt;header></varname>不设置，查询所有实例的通用报头：</div><msgblock id="msgblock_als_lzt_pqb">[+MHTTPCFG: "header",&lt;httpid>,&lt;header_len>,&lt;header>
[…]]
OK</msgblock>
                            <varname>&lt;httpid></varname>设置，<varname>&lt;header></varname>不设置，查询指定实例的通用报头：<msgblock id="msgblock_hl4_vcj_lrb">[+MHTTPCFG: "header",&lt;httpid>,&lt;header_len>,&lt;header>]
OK</msgblock>所有参数都设置，设置通用报头：<msgblock id="msgblock_fqg_zcj_lrb">OK</msgblock>错误<msgblock id="msgblock_ogt_mzt_pqb">+CME ERROR: &lt;err></msgblock></entry>
                    </row>
                    <row>
                        <entry>设置命令（传输模式设置）<codeblock><cmdname>AT+MHTTPCFG="chunked"[,&lt;httpid>[,&lt;chunked_mode>]]</cmdname></codeblock></entry>
                        <entry>成功<div><varname>&lt;httpid></varname>和<varname>&lt;chunked_mode></varname>不设置，查询所有实例的传输模式：</div><msgblock id="msgblock_c5x_115_pqb">[+MHTTPCFG: "chunked",&lt;httpid>,&lt;chunked_mode>
[…]]
OK</msgblock>
                            <varname>&lt;httpid></varname>设置，<varname>&lt;chunked_mode></varname>不设置，查询指定实例的传输模式：<msgblock id="msgblock_pmg_jgj_lrb">+MHTTPCFG: "chunked",&lt;httpid>,&lt;chunked_mode>
OK</msgblock>所有参数都设置，设置传输模式：
                            <msgblock id="msgblock_qmg_jgj_lrb">OK</msgblock>
                            错误<msgblock id="msgblock_afn_b15_pqb">+CME ERROR: &lt;err></msgblock></entry>
                    </row>
                    <row>
                        <entry>设置命令（缓存模式设置）<codeblock><cmdname>AT+MHTTPCFG="cached"[,&lt;httpid>[,&lt;cached>[,&lt;cache_length>]]]</cmdname></codeblock></entry>
                        <entry>成功<div><varname>&lt;httpid></varname>、<varname>&lt;cached></varname>、<varname>&lt;cache_length></varname>不设置，查询所有实例的缓存模式：</div><msgblock id="msgblock_qrk_j15_pqb">[+MHTTPCFG: "cached",&lt;httpid>,&lt;cached>[,&lt;cache_length>]
[…]]
OK</msgblock>
                            <varname>&lt;httpid></varname>设置，<varname>&lt;cached></varname>、<varname>&lt;cache_length></varname>不设置，查询指定实例的缓存模式：<msgblock id="msgblock_w3w_5gj_lrb">+MHTTPCFG: "cached",&lt;httpid>,&lt;cached>[,&lt;cache_length>]
OK</msgblock><varname>&lt;httpid></varname>和<varname>&lt;cached></varname>设置，<varname>&lt;cache_length></varname>不设置，设置缓存模式，不设置缓存空间大小：<msgblock id="msgblock_vgf_vgj_lrb">OK</msgblock>所有参数都设置，设置缓存模式和缓存空间大小：<msgblock id="msgblock_pj4_bhj_lrb">OK</msgblock>错误<msgblock id="msgblock_ivr_j15_pqb">+CME ERROR: &lt;err></msgblock></entry>
                    </row>
                    <row>
                        <entry>设置命令（超时时间设置）<codeblock><cmdname>AT+MHTTPCFG="timeout"[,&lt;httpid>[,&lt;conn_timeout>[,&lt;rsp_timeout>[,&lt;input_timeout>]]]]</cmdname></codeblock></entry>
                        <entry>成功<div><varname>&lt;httpid></varname>、<varname>&lt;conn_timeout></varname>、<varname>&lt;rsp_timeout></varname>、<varname>&lt;input_timeout></varname>不设置，查询所有实例的超时时间：</div><msgblock id="msgblock_mqd_l15_pqb">[+MHTTPCFG: "timeout",&lt;httpid>,&lt;conn_timeout>,&lt;rsp_timeout>[,&lt;input_timeout>]
[…]]
OK</msgblock>
                            <varname>&lt;httpid></varname>设置，<varname>&lt;conn_timeout></varname>、<varname>&lt;rsp_timeout></varname>、<varname>&lt;input_timeout></varname>不设置，查询指定实例的超时时间：<msgblock id="msgblock_qj5_khj_lrb">+MHTTPCFG: "timeout",&lt;httpid>,&lt;conn_timeout>,&lt;rsp_timeout>[,&lt;input_timeout>]
OK</msgblock><varname>&lt;httpid></varname>设置，<varname>&lt;conn_timeout></varname>、<varname>&lt;rsp_timeout></varname>、<varname>&lt;input_timeout></varname>部分设置或全部设置，设置相应的超时时间：<msgblock id="msgblock_zyn_phj_lrb">OK</msgblock>错误<msgblock id="msgblock_gtg_l15_pqb">+CME ERROR: &lt;err></msgblock></entry>
                    </row>
                    <row>
                        <entry>设置命令（输入输出编码模式设置）<codeblock><cmdname>AT+MHTTPCFG="encoding"[,&lt;httpid>[,&lt;input_format>[,&lt;output_format>]]]</cmdname></codeblock></entry>
                        <entry>成功<div><varname>&lt;httpid></varname>、<varname>&lt;input_format></varname>、<varname>&lt;output_format></varname>不设置，查询所有实例的输入输出编码模式：</div><msgblock id="msgblock_jkj_n15_pqb">[+MHTTPCFG: "encoding",&lt;httpid>,&lt;input_format>,&lt;output_format>
[…]]
OK</msgblock>
                            <varname>&lt;httpid></varname>设置，<varname>&lt;input_format></varname>、<varname>&lt;output_format></varname>不设置，查询指定实例的输入输出编码模式：<msgblock id="msgblock_sq4_jcn_lrb">+MHTTPCFG: "encoding",&lt;httpid>,&lt;input_format>,&lt;output_format>
OK</msgblock><varname>&lt;httpid></varname>设置，<varname>&lt;input_format></varname>、<varname>&lt;output_format></varname>部分设置或全部设置，设置相应的编码模式：<msgblock id="msgblock_agx_lcn_lrb">OK</msgblock>错误<msgblock id="msgblock_cmm_n15_pqb">+CME ERROR: &lt;err></msgblock></entry>
                    </row>
                    <row>
                        <entry>设置命令（SSL模式设置）<codeblock><cmdname>AT+MHTTPCFG="ssl"[,&lt;httpid>[,&lt;ssl_enable>[,&lt;ssl_id>]]]</cmdname></codeblock></entry>
                        <entry>成功<div><varname>&lt;httpid></varname>、<varname>&lt;ssl_enable></varname>、<varname>&lt;ssl_id></varname>不设置，查询所有实例的SSL模式：</div><msgblock id="msgblock_lvz_415_pqb">[+MHTTPCFG: "ssl",&lt;httpid>,&lt;ssl_enable>[,&lt;ssl_id>]
[…]]
OK</msgblock>
                            <varname>&lt;httpid></varname>设置，<varname>&lt;ssl_enable></varname>、<varname>&lt;ssl_id></varname>不设置，查询指定实例的SSL模式：<msgblock id="msgblock_nbz_zcn_lrb">+MHTTPCFG: "ssl",&lt;httpid>,&lt;ssl_enable>[,&lt;ssl_id>]
OK</msgblock><varname>&lt;httpid></varname>设置，<varname>&lt;ssl_enable></varname>、<varname>&lt;ssl_id></varname>部分设置或全部设置，设置SSL模式：<msgblock id="msgblock_y5f_xcn_lrb">OK</msgblock>错误<msgblock id="msgblock_bg2_p15_pqb">+CME ERROR: &lt;err></msgblock></entry>
                    </row>
                    <row>
                        <entry>设置命令（cid设置）<codeblock><cmdname>AT+MHTTPCFG="cid"[,&lt;httpid>[,&lt;cid>]]</cmdname></codeblock></entry>
                        <entry>成功<div><varname>&lt;httpid></varname>、<varname>&lt;cid></varname>不设置，查询所有实例的cid：</div><msgblock id="msgblock_dfp_q15_pqb">[+MHTTPCFG: "cid",&lt;httpid>[,&lt;cid>]
[…]]
OK</msgblock>
                            <varname>&lt;httpid></varname>设置，<varname>&lt;cid></varname>不设置，查询指定实例的cid：<msgblock id="msgblock_ydp_jdn_lrb">+MHTTPCFG: "cid",&lt;httpid>[,&lt;cid>]
OK</msgblock><varname>&lt;httpid></varname>、<varname>&lt;cid></varname>设置，设置cid：<msgblock id="msgblock_rh1_ldn_lrb">OK</msgblock>错误<msgblock id="msgblock_xns_q15_pqb">+CME ERROR: &lt;err></msgblock></entry>
                    </row>
                    <row>
                        <entry>设置命令（数据输出流控设置）<codeblock><cmdname>AT+MHTTPCFG="fragment"[,&lt;httpid>[,&lt;frag_size>[,&lt;interval>]]]</cmdname></codeblock></entry>
                        <entry>成功<div><varname>&lt;httpid></varname>、<varname>&lt;frag_size></varname>、<varname>&lt;interval></varname>不设置，查询所有实例的数据输出流控模式：</div><msgblock id="msgblock_l54_s15_pqb">[+MHTTPCFG: "fragment",&lt;httpid>,&lt;frag_size>,&lt;interval>
[…]]
OK</msgblock>
                            <varname>&lt;httpid></varname>设置，<varname>&lt;frag_size></varname>、<varname>&lt;interval></varname>不设置，查询指定实例的数据输出流控模式：<msgblock id="msgblock_yzs_pdn_lrb">+MHTTPCFG: "fragment",&lt;httpid>,&lt;frag_size>,&lt;interval>
OK</msgblock><varname>&lt;httpid></varname>设置，<varname>&lt;frag_size></varname>、<varname>&lt;interval></varname>部分设置或全部设置，设置数据输出流控模式：<msgblock id="msgblock_wyh_rdn_lrb">OK</msgblock>错误<msgblock id="msgblock_e5r_s15_pqb">+CME ERROR: &lt;err></msgblock></entry>
                    </row>
                    <row>
                        <entry>设置命令（URL编码设置）<codeblock><cmdname>AT+MHTTPCFG="urlencode"[,&lt;httpid>[,&lt;urlencode_mode>]]</cmdname></codeblock></entry>
                        <entry>成功<div><varname>&lt;httpid></varname>、<varname>&lt;urlencode_mode></varname>不设置，查询所有实例的URL编码模式：</div><msgblock id="msgblock_rzl_bb5_pqb">[+MHTTPCFG: "urlencode",&lt;httpid>,&lt;urlencode_mode>
[…]]
OK</msgblock>
                            <varname>&lt;httpid></varname>设置，<varname>&lt;urlencode_mode></varname>不设置，查询指定实例的URL编码模式：<msgblock id="msgblock_ulx_5dn_lrb">+MHTTPCFG: "urlencode",&lt;httpid>,&lt;urlencode_mode>
OK</msgblock><varname>&lt;httpid></varname>、<varname>&lt;urlencode_mode></varname>设置，设置URL编码模式：<msgblock id="msgblock_szb_ydn_lrb">OK</msgblock>错误<msgblock id="msgblock_lt4_bb5_pqb">+CME ERROR: &lt;err></msgblock></entry>
                    </row>
                    <row>
                        <entry>设置命令（wtcp模式设置）<fn>目前仅ML307B支持“wtcp模式设置”。</fn><codeblock id="codeblock_yqd_mfw_4hc"><cmdname>AT+MHTTPCFG="wtcp"[,&lt;avoid_enable>[,&lt;option_kind>]]</cmdname></codeblock></entry>
                        <entry>成功<div><varname>&lt;avoid_enable></varname>、<varname>&lt;option_kind></varname>不设置，查询当前wtcp模式和TCP
                                options配置值：</div><div>
                                <codeblock id="codeblock_kgv_lhw_4hc">+MHTTPCFG: "wtcp",&lt;avoid_enable>[,&lt;option_kind>]
OK</codeblock>
                            </div><div><varname>&lt;avoid_enable></varname>、<varname>&lt;option_kind></varname>部分设置或全部设置，设置wtcp模式和TCP
                                options配置值：</div><div>
                                <codeblock id="codeblock_qmk_23w_4hc">OK</codeblock>
                            </div><div>错误</div><div>
                                <codeblock id="codeblock_spt_g3w_4hc">+CME ERROR: &lt;err></codeblock>
                            </div></entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">命令描述</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                                >读取命令将返回所有已创建实例的所有配置参数；设置命令中，如果只设置<varname>&lt;cmd></varname>（命令标识符），将返回所有已创建实例的当前配置参数，如果只设置<varname>&lt;cmd></varname>和<varname>&lt;httpid></varname>（客户端实例id），将返回当前实例的当前配置参数，如果其他参数也设置，将设置相应模式。需创建实例后，才可进行参数设置。</entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">参数描述</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                                        ><varname>&lt;cmd></varname>命令标识符。<fn><div>MN318<ph
                                        product="tbd"
                                    >/MN328</ph>/ML307H-GU：不支持"ssl"设置，不支持ssl加密传输。</div><div/>MN316/MN326：不支持"cid"设置。<div/><div><ph
                                        product="tbd"
                                    >MN327：不支持"ssl"设置。</ph></div><div/>MN319/MN319-A/MN316A/MN326A<ph
                                    product="tbd"
                                    >/M5310-E</ph>：不支持"ssl"和"cid"设置，不支持ssl加密传输。<div>目前仅ML307B支持"wtcp"设置。</div></fn></entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">
                            <parml id="parml_cfz_pgj_1rb">
                                <plentry>
                                    <pt>header</pt>
                                    <pd>通用报头设置，应用于实例生命周期，设置时需按<msgph>key:
                                        value</msgph>的形式分字段进行设置，模组会保存所有设置字段。</pd>
                                </plentry>
                                <plentry>
                                    <pt>chunked</pt>
                                    <pd>传输模式设置。普通模式（Content-Length模式）与Chunked模式的使用流程存在差异。普通模式先设置content数据，后发送请求；Chunked模式先发送请求，后设置content数据。</pd>
                                </plentry>
                                <plentry>
                                    <pt>cached</pt>
                                    <pd>缓存模式设置，设置为缓存模式时，接收数据将缓存在模组中，请求完成时上报提示，用户手动读取。</pd>
                                </plentry>
                                <plentry>
                                    <pt>timeout</pt>
                                    <pd>超时时间设置，包含连接超时、响应超时、数据输入超时。</pd>
                                </plentry>
                                <plentry>
                                    <pt>encoding</pt>
                                    <pd>输入输出数据编码设置。</pd>
                                </plentry>
                                <plentry>
                                    <pt>ssl</pt>
                                    <pd>SSL使能设置，用于HTTPS。</pd>
                                </plentry>
                                <plentry>
                                    <pt>cid</pt>
                                    <pd>PDP上下文cid设置。</pd>
                                </plentry>
                                <plentry>
                                    <pt>fragment</pt>
                                    <pd>数据输出流控设置，用于数据输出打印时控制分包输出。</pd>
                                </plentry>
                                <plentry>
                                    <pt>urlencode</pt>
                                    <pd>URL编码设置，使能后，模组将自动对请求的path进行编码，不对字母数字以及-_.!~*'();/?:@&amp;=+$,#进行编码。</pd>
                                </plentry>
                                <plentry>
                                    <pt>wtcp</pt>
                                    <pd>wtcp模式设置，包括是否绕过wtcp，以及绕过时选用的TCP options配置值。</pd>
                                </plentry>
                            </parml>
                        </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                                ><varname>&lt;httpid></varname>客户端实例id，<cmdname>AT+MHTTPCREATE</cmdname>创建成功后返回，0~3。
                                    <fn>MN319/MN319-A/MN316A/MN326A：<varname>&lt;httpid></varname>参数范围0~1。</fn></entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                            ><varname>&lt;header_len></varname>通用报头长度。</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                                ><varname>&lt;header></varname>通用报头，应用于实例生命周期，设置时需按<msgph>key:
                                value</msgph>的形式分字段进行设置，模组会保存所有设置字段。<fn>ML302A/ML305A/ML307A/ML307G/ML307M/ML307R/ML307B/ML307C/ML307H/ML307N：<varname>&lt;header></varname>参数输入长度范围为1~1024。</fn></entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                            ><varname>&lt;chunked_mode></varname>传输模式，默认值0。</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">
                            <parml id="parml_dj2_f4s_frb">
                                <plentry>
                                    <pt>0</pt>
                                    <pd>content_length模式</pd>
                                </plentry>
                                <plentry>
                                    <pt>1</pt>
                                    <pd>chunked模式</pd>
                                </plentry>
                            </parml>
                        </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                            ><varname>&lt;cached></varname>缓存模式，默认值0。</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">
                            <parml id="parml_u4j_m4s_frb">
                                <plentry>
                                    <pt>0</pt>
                                    <pd>非缓存模式</pd>
                                </plentry>
                                <plentry>
                                    <pt>1</pt>
                                    <pd>缓存模式</pd>
                                </plentry>
                            </parml>
                        </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                                    ><varname>&lt;cache_length></varname>缓存空间，默认值4K（4096字节），1~8192字节。<fn>当<varname>&lt;cached></varname>为0时（非缓存模式），查询时不显示<varname>&lt;cache_length></varname>。此外，MN316A/MN326A：支持范围1~4096字节。</fn></entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                            ><varname>&lt;conn_timeout></varname>连接超时时间，0~180s，默认值60s。</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                            ><varname>&lt;rsp_timeout></varname>服务器响应超时时间，0~60s，默认值0s（不超时）。</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                                ><varname>&lt;input_timeout></varname>数据输入超时时间，0~180s，默认值10s。（AT命令输入数据，并采用<keyword>></keyword>模式输入时。）<fn>
                                <div><ph product="tbd"
                                        >M5310-E/MN328/</ph>MN318/MN316/MN319/MN319-A/MN326/MN316A/MN326A：不支持数据模式输入，因此不支持<varname>&lt;input_timeout></varname>参数设置。 </div>
                                <div>ML302S/ML307S/ML302A/ML305A/ML307A/ML307G/ML305U/ML305M/ML307R/ML307B/ML307C/ML307M/ML307H/ML307X/ML307Y/MR380R<ph
                                        product="tbd"
                                        ><?oxy_insert_start author="surui" timestamp="20260622T110436+0800"?>/MR380M<?oxy_insert_end?></ph>：支持范围1~120s。</div>
                                <div>ML307N：支持范围0~120s。</div>
                            </fn></entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                                    ><varname>&lt;input_format></varname>数据输入编码模式，默认值0。模组将按设置的编码格式把输入数据转换为原始数据。<fn>该参数影响如下命令的数据输入：<cmdname>AT+MHTTPCFG="header"</cmdname>、<cmdname>AT+MHTTPHEADER</cmdname>、<cmdname>AT+MHTTPCONTENT</cmdname>、<cmdname>AT+MHTTPREQUEST</cmdname>。MR880A不支持2。</fn></entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">
                            <parml>
                                <plentry>
