<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic
  PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="Toc11527">
      <title>Unsolicited HTTP Header Reporting</title>
      <body>
        <table colsep="1" frame="all" rowsep="1">
                    <tgroup cols="2">
            <colspec colname="col1" colnum="1" colwidth="0.7*"/>
            <colspec colname="col2" colnum="2" colwidth="1.3*"/>
            <thead>
              <row>
                <entry>Command</entry>
                <entry>Response</entry>
              </row>
            </thead>
            <tbody>
              <row>
                <entry>+HTTPNMIH</entry>
                <entry>
                  <div>+HTTPNMIH:&lt;id&gt;,&lt;responseCode&gt;,&lt;length&gt;</div>
                  <div>&lt;header&gt;</div>
                </entry>
              </row>
            </tbody>
          </tgroup>
        </table>
        <p>Command Description:</p>
        <p>
This command reports the received HTTP headers unsolicitedly. </p>
        <p>Parameter Description: </p>
        <p>
&lt;id&gt;: Client instance created by the AT+HTTPCREATE command. </p>
        <p>
&lt;responseCode&gt;: HTTP status code. Refer to Chapter 4. </p>
        <p>
&lt;length&gt;: Length of the header information. </p>
        <p>
&lt;header&gt;: Header information. </p>
      </body>
    </topic>
