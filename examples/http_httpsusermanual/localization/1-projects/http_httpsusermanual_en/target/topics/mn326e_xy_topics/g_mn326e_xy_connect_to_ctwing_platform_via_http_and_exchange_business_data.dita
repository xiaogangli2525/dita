<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic
  PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="Toc12378">
      <title>Connect to the CTWING Platform via HTTP and Perform Service Data Exchange</title>
      <body>
        <p>
The official CTWING help documentation link is as follows: <xref format="html" href="https://www.ctwing.cn/sbjr/62" scope="external">https://www.ctwing.cn/sbjr/62</xref>
        </p>
        <table colsep="1" frame="all" rowsep="1">
          <tgroup cols="1">
            <colspec colname="col1" colnum="1" colwidth="1*"/>
            <tbody>
              <row>
                <entry>
                  <p>
// Log in to CTWING platform via HTTP</p>
                  <p>// Create HTTP instance</p>
                  <p>
AT+HTTPCREATE=<xref format="html" href="http://http.ctwing.cn:8991" scope="external">http://http.ctwing.cn:8991</xref>
                  </p>
                  <p>+HTTPCREATE:0</p>
                  <p>OK</p>
                  <p>
// Signature key, generated by the device (customized), carried to the platform</p>
                  <p>AT+HTTPHEADER=0,"signKey: test\r\n",0</p>
                  <p>OK</p>
                  <p>
// Timestamp (self-generated).  (Valid for 20 minutes, with a time difference of no more than 10 minutes)       </p>
                  <p>AT+HTTPHEADER=0,"timestamp: 1663900280590\r\n",0</p>
                  <p>OK</p>
                  <p>
// MasterKey is automatically generated when the product is created on the platform and can be queried in the Product Overview. </p>
                  <p>AT+HTTPHEADER=0,"signature:
b821e3990ad0493867e9a2b8447e449847f7be138eb571ada4a5f39e4d755269\r\n",0</p>
                  <p>OK</p>
                  <p>AT+HTTPHEADER=0,"Content-Type: application/json\r\n",0</p>
                  <p>OK</p>
                  <p>
// HTTP protocol login authentication request parameters</p>
                  <p>
AT+HTTPCONTENT=0,"{\"productId\":15345508,\"deviceId\":\"15345508232354562315557\",\"password\":\"aDlCUezZ5QnXXaPWttU0gtJaZpflEQvBnFPwGRjq1As\",\"version\":\"1.0\"}",0</p>
                  <p>OK</p>
                  <p>AT+HTTPSEND=0,1,"/auth"</p>
                  <p>OK</p>
                  <p>+REQUESTSUCCESS // HTTPS request successful</p>
                  <p>+HTTPNMIH:0,200,105
//HTTP authentication response parameters for login. The server response content is shown in the serial port screenshot below. Data is presented in its original form. Further processing is up to the customer.</p>
                  <p>content-length: 79</p>
                  <p>content-type: application/json</p>
                  <p>date: Fri, 23 Sep 2022 02:33:54 GMT</p>
                  <p>server: Cowboy</p>
                  <p>+HTTPNMIC:0,0,79,79</p>
                  <p>

{"message":"SUCCESSFUL","code":0,"accessToken":"5E98C4D164FFD6C4467190E230000"}
// Randomly and dynamically generated</p>
                  <p>+HTTPERR:0,-7
// Error code reported, indicating that the server has disconnected the TCP connection.</p>
                  <p>// Close HTTPS instance</p>
                  <p>AT+HTTPCLOSE=0</p>
                  <p>OK</p>
                  <p>
// Data exchange with CTWING platform via HTTP</p>
                  <p>// Create HTTP instance</p>
                  <p>AT+HTTPCREATE=<xref format="html" href="http://http.ctwing.cn:8991" scope="external">http://http.ctwing.cn:8991</xref>
                  </p>
                  <p>+HTTPCREATE:0</p>
                  <p>OK</p>
                  <p>
// Signature key, generated by the device (customized), carried to the platform</p>
                  <p>AT+HTTPHEADER=0,"signKey: test\r\n",0</p>
                  <p>OK</p>
                  <p>
// Timestamp (self-generated).  (Valid for 20 minutes, with a time difference of no more than 10 minutes)       </p>
                  <p>AT+HTTPHEADER=0,"timestamp: 1663900280590\r\n",0</p>
                  <p>OK</p>
                  <p>
// MasterKey is automatically generated when the product is created on the platform and can be queried in the Product Overview. </p>
                  <p>AT+HTTPHEADER=0,"signature:
b821e3990ad0493867e9a2b8447e449847f7be138eb571ada4a5f39e4d755269\r\n",0</p>
                  <p>OK</p>
                  <p>AT+HTTPHEADER=0,"Content-Type: application/json\r\n",0</p>
                  <p>OK</p>
                  <p>
// HTTP protocol service data development request parameters</p>
                  <p>
AT+HTTPCONTENT=0,"{\"productId\":15345508,\"deviceId\":\"15345508232354562315557\",\"accessToken\":\"5E98C4D164FFD6C4467190E230000\",\"topic\":\"data_report\",\"payload\":{\"water_flow\":15.0}}",0</p>
                  <p>OK</p>
                  <p>AT+HTTPSEND=0,1,"/topic"</p>
                  <p>OK</p>
                  <p>+REQUESTSUCCESS // HTTPS request successful</p>
                  <p>+HTTPNMIH:0,200,105
//HTTP authentication response parameters for login. The server response content is shown in the serial port screenshot below. Data is presented in its original form. Further processing is up to the customer.</p>
                  <p>content-length: 33</p>
                  <p>content-type: application/json</p>
                  <p>date: Mon, 26 Sep 2022 03:42:01 GMT</p>
                  <p>server: Cowboy</p>
                  <p>+HTTPNMIC:0,0,33,33</p>
                  <p>{"message":"SUCCESSFUL","code":0}</p>
                  <p>+HTTPERR:0,-7
// Error code reported, indicating that the server has disconnected the TCP connection.</p>
                  <p>// Close HTTPS instance</p>
                  <p>AT+HTTPCLOSE=0</p>
                  <p>OK</p>
                </entry>
              </row>
            </tbody>
            
          </tgroup>
        </table>
      </body>
    </topic>
