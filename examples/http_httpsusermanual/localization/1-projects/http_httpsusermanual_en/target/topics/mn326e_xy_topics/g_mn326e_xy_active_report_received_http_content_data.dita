<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE topic
  PUBLIC "-//OASIS//DTD DITA Topic//EN" "topic.dtd">
<topic id="Toc951">
      <title>Unsolicited Reporting of Received HTTP Content Data</title>
      <body>
        <table colsep="1" frame="all" rowsep="1">
                    <tgroup cols="2">
            <colspec colname="col1" colnum="1" colwidth="0.7*"/>
            <colspec colname="col2" colnum="2" colwidth="1.3*"/>
            <thead>
              <row>
                <entry>Command</entry>
                <entry>Response</entry>
              </row>
            </thead>
            <tbody>
              <row>
                <entry>+HTTPNMIC</entry>
                <entry>
                  <div>
+HTTPNMIC:&lt;id&gt;,&lt;more&gt;,&lt;total&gt;,&lt;cur_len&gt;</div>
                  <div>&lt;content&gt;</div>
                </entry>
              </row>
            </tbody>
          </tgroup>
        </table>
        <p>Command Description:</p>
        <p>
This command unsolicitedly reports the received HTTP content data. </p>
        <p>Parameter Description: </p>
        <p>
&lt;id&gt;: Client instance created by the AT+HTTPCREATE command. </p>
        <p>
&lt;more&gt;: Whether more data follows. </p>
        <p>
&lt;total&gt;: The total length of the Content-Length field output this time, or the total length of chunked transmission segments. In chunked mode, the total field shall increase incrementally as each chunked segment is parsed. </p>
        <p>
&lt;cur_len&gt;: Length of the current output packet. </p>
        <p>&lt;content&gt;: HTTP data content. </p>
      </body>
    </topic>
