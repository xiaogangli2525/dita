<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="reference_qd5_gdq_cqb">
    <title><?oxy_comment_start author="zhangqin1@cmiot.cmcc" timestamp="20241101T141814+0800" comment="该内容模块为基础版本共用，请勿随意删减。若需添加仅适用于某型号的内容，请添加批注说明"?>+HTTPNMIH<?oxy_comment_end?></title>
        <shortdesc>Actively report the received HTTP header. </shortdesc>
    <refbody>
        <table id="table_btl_krz_3qb">
                        <tgroup cols="2">
                <colspec colname="c1" colnum="1" colwidth="3*" align="left"/>
                <colspec colname="c2" colnum="2" colwidth="7*" align="left"/>
                <thead>
                    <row>
                        <entry namest="c1" nameend="c2"><cmdname>+HTTPNMIH</cmdname></entry>
                    </row>
                </thead>
                <tbody>
                    <row outputclass="has_bgc">
                        <entry>Syntax </entry>
                        <entry>Response </entry>
                    </row>
                    <row>
                        <entry>
                            <codeblock><cmdname>+HTTPNMIH</cmdname></codeblock>
                        </entry>
                        <entry>
                            <msgblock id="msgblock_emt_xb5_pqb">+HTTPNMIH:&lt;id&gt;,&lt;more&gt;,&lt;length&gt;
&lt;header&gt;</msgblock>
                        </entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">Command Description</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">Actively report the received HTTP header. </entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">Parameter Description</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                                ><varname>&lt;id&gt;</varname>Integer. Instance index returned by <msgph>+HTTPCREATE</msgph>. Range: 0~4.  <fn>M5310-E/MN328-B range: 0~1.  </fn></entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                            ><varname>&lt;more&gt;</varname>Integer. Whether more header data follows. </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                            ><varname>&lt;length&gt;</varname>Integer. Length of the header information output in this transmission. </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                            ><varname>&lt;header&gt;</varname>String. Header content. Current maximum supported size: 1460 bytes. </entry>
                    </row>
                </tbody>
            </tgroup>
        </table>
    </refbody>
</reference>
