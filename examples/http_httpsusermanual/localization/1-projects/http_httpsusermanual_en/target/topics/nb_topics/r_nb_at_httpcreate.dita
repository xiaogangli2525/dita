<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="reference_qd5_gdq_cqb">
    <title><?oxy_comment_start author="zhangqin1@cmiot.cmcc" timestamp="20241101T113235+0800" comment="该内容模块为基础版本共用，请勿随意删减。若需添加仅适用于某型号的内容，请添加批注说明。"?>AT+HTTPCREATE<?oxy_comment_end?></title>
        <shortdesc>This command is used to create HTTP instances.  </shortdesc>
    <refbody>
        <table id="table_btl_krz_3qb">
                        <tgroup cols="2">
                <colspec colname="c1" colnum="1" colwidth="3*" align="left"/>
                <colspec colname="c2" colnum="2" colwidth="7*" align="left"/>
                <thead>
                    <row>
                        <entry namest="c1" nameend="c2"><cmdname>AT+HTTPCREATE</cmdname></entry>
                    </row>
                </thead>
                <tbody>
                    <row outputclass="has_bgc">
                        <entry>Syntax </entry>
                        <entry>Response </entry>
                    </row>
                    <row>
                        <entry>Set Command <codeblock><cmdname>AT+HTTPCREATE=&lt;URL&gt;[,&lt;user&gt;,&lt;password&gt;]</cmdname></codeblock></entry>
                        <entry>If succeed <div>If the input format is correct, and the number of created instances does not exceed the limit:</div><msgblock id="msgblock_xmq_xb5_pqb">+HTTPCREATE:&lt;id&gt;
OK</msgblock>If fail <msgblock id="msgblock_emt_xb5_pqb">ERROR</msgblock></entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">Command Description </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">This command is used to create HTTP instances.  </entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">Parameter Description </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                            ><varname>&lt;URL&gt;</varname>String. The server domain or IP address.  </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"><varname>&lt;user&gt;</varname>String. Username.  </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                            ><varname>&lt;password&gt;</varname>String. Passwords.  </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                                ><varname>&lt;id&gt;</varname>Integer. Returned HTTP instance index. Range: 0~4.  <fn>M5310-E/MN328-B range: 0~1.  </fn></entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">Example</entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">Create instances
                            <msgblock id="codeblock_l2w_nfj_1rb"><cmdname>AT+HTTPCREATE="http://iot.10086.cn:80/joinus/index/name/joinus.html"</cmdname>    
+HTTPCREATE:0 /*The returned HTTP instance ID shall be used as a reference for subsequent operations. */
OK</msgblock></entry>
                    </row>
                </tbody>
            </tgroup>
        </table>
        <section id="section_bcz_1gm_jcc">
            <note id="note_csg_bgm_jcc">
                <ul id="ul_jxj_ggm_jcc">
                    <li>If the URL prefix <msgph>http://</msgph> is not entered, HTTP is used by default. The path field in the URL will be ignored; </li>
                    <li>Currently, only HTTP is supported. The user and password are needed for websites requiring authentication. Only basic authentication is supported.</li>
                </ul>
            </note>
        </section>
    </refbody>
</reference>
