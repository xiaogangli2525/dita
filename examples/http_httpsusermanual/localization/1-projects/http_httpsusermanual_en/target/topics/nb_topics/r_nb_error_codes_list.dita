<reference id="reference_rvw_hgm_gqb">
    <title>Error Code </title>
    <refbody>
        <table id="table_ttt_zfx_jqb">
            <title>M5310-E/MN328-B Error Code </title>
                        <tgroup cols="2">
                <colspec colname="c1" colnum="1" colwidth="3*" align="left"/>
                <colspec colname="c2" colnum="2" colwidth="7*" align="left"/>
                <thead>
                    <row>
                        <entry>Status Code</entry>
                        <entry>Description </entry>
                    </row>
                </thead>
                <tbody>
                    <row>
                        <entry>-1</entry>
                        <entry>Memory error</entry>
                    </row>
                    <row>
                        <entry>-2</entry>
                        <entry>Buffer error</entry>
                    </row>
                    <row>
                        <entry>-3</entry>
                        <entry>TCP Timeout or Unknown client error</entry>
                    </row>
                    <row>
                        <entry>-4</entry>
                        <entry>Routing error or HTTP parse error</entry>
                    </row>
                    <row>
                        <entry>-5</entry>
                        <entry>TCP operation in progress or client DNS error</entry>
                    </row>
                    <row>
                        <entry>-6</entry>
                        <entry>TCP illegal value or URL parse error</entry>
                    </row>
                    <row>
                        <entry>-7</entry>
                        <entry>Operation would block</entry>
                    </row>
                    <row>
                        <entry>-8</entry>
                        <entry>Address in use</entry>
                    </row>
                    <row>
                        <entry>-9</entry>
                        <entry>Already connecting</entry>
                    </row>
                    <row>
                        <entry>-10</entry>
                        <entry>Connection already established</entry>
                    </row>
                    <row>
                        <entry>-11</entry>
                        <entry>No connection</entry>
                    </row>
                    <row>
                        <entry>-12</entry>
                        <entry>Interface error</entry>
                    </row>
                    <row>
                        <entry>-13</entry>
                        <entry>Connection aborted</entry>
                    </row>
                    <row>
                        <entry>-14</entry>
                        <entry>Connection reset</entry>
                    </row>
                    <row>
                        <entry>-15</entry>
                        <entry>Connection closed</entry>
                    </row>
                    <row>
                        <entry>-16</entry>
                        <entry>Illegal argument</entry>
                    </row>
                </tbody>
            </tgroup>
        </table>
