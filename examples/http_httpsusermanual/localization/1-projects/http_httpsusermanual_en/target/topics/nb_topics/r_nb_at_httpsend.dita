<reference id="reference_qd5_gdq_cqb">
    <title><?oxy_comment_start author="zhangqin1@cmiot.cmcc" timestamp="20241101T141753+0800" comment="该内容模块为基础版本共用，请勿随意删减。若需添加仅适用于某型号的内容，请添加批注说明"?>AT+HTTPSEND<?oxy_comment_end?></title>
        <shortdesc>This command is used to send HTTP request.  </shortdesc>
    <refbody>
        <table id="table_btl_krz_3qb">
                        <tgroup cols="2">
                <colspec colname="c1" colnum="1" colwidth="3*" align="left"/>
                <colspec colname="c2" colnum="2" colwidth="7*" align="left"/>
                <thead>
                    <row>
                        <entry namest="c1" nameend="c2"><cmdname>AT+HTTPSEND</cmdname></entry>
                    </row>
                </thead>
                <tbody>
                    <row outputclass="has_bgc">
                        <entry>Syntax </entry>
                        <entry>Response </entry>
                    </row>
                    <row>
                        <entry>Set Command <codeblock><cmdname>AT+HTTPSEND=&lt;id&gt;,&lt;method&gt;,&lt;path&gt;</cmdname></codeblock></entry>
                        <entry>If succeed <div>If the input format is correct, the following is returned: </div><msgblock id="msgblock_xmq_xb5_pqb">OK</msgblock>If fail<msgblock id="msgblock_cv3_cj3_ncc">ERROR</msgblock></entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">Command Description </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">This command is used to send HTTP request.  </entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">Parameter Description </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                                ><varname>&lt;id&gt;</varname>Integer. The instance index returned by <msgph>+HTTPCREATE</msgph>. Range: 0~4.  <fn>M5310-E/MN328-B range: 0~1.  </fn></entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                            ><varname>&lt;method&gt;</varname>Integer. HTTP request type. </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">
                            <dl>
                                <dlentry>
                                    <dt>0</dt>
                                    <dd>GET</dd>
                                </dlentry>
                                <dlentry>
                                    <dt>1</dt>
                                    <dd>POST</dd>
                                </dlentry>
                                <dlentry>
                                    <dt>2</dt>
                                    <dd>PUT</dd>
                                </dlentry>
                                <dlentry>
                                    <dt>3</dt>
                                    <dd>DELETE</dd>
                                </dlentry>
                                <dlentry>
                                    <dt>4</dt>
                                    <dd>HEAD</dd>
                                </dlentry>
                            </dl>
                                                </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"><varname>&lt;path&gt;</varname>String. The absolute path parameter 
                            of the requested URL. </entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">Example </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                            >Create instances <div>IPv4: </div><msgblock id="codeblock_l2w_nfj_1rb"><cmdname>AT+HTTPSEND=0,0,"/page/index/name/zhangcheng"</cmdname>
