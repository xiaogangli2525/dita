<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE reference PUBLIC "-//OASIS//DTD DITA Reference//EN" "reference.dtd">
<reference id="reference_agm_qdq_cqb">
    <title>AT+MHTTPTERM Terminate HTTP Transmission </title>
        <shortdesc>This command is used to terminate current HTTP transmission.  </shortdesc>
    <refbody>
        <table id="table_q11_4rv_jqb">
                        <tgroup cols="2">
                <colspec colname="c1" colnum="1" colwidth="3*" align="left"/>
                <colspec colname="c2" colnum="2" colwidth="7*" align="left"/>
                <thead>
                    <row>
                        <entry namest="c1" nameend="c2"><cmdname>AT+MHTTPTERM</cmdname></entry>
                    </row>
                </thead>
                <tbody>
                    <row outputclass="has_bgc">
                        <entry>Syntax </entry>
                        <entry>Response </entry>
                    </row>
                    <row>
                        <entry>Test command <codeblock><cmdname>AT+MHTTPTERM=?</cmdname></codeblock></entry>
                        <entry>If succeed: <msgblock id="msgblock_fjd_kf5_pqb">+MHTTPTERM: (list of supported &lt;httpid&gt;s)
OK</msgblock>
                            If fail: <msgblock id="msgblock_rmg_kf5_pqb">+CME ERROR: &lt;err&gt;</msgblock></entry>
                    </row>
                    <row>
                        <entry>Execution command <codeblock><cmdname>AT+MHTTPTERM</cmdname></codeblock></entry>
                        <entry>If succeed: <msgblock id="msgblock_e52_lf5_pqb">OK</msgblock>
                            If fail: <msgblock id="msgblock_k2j_lf5_pqb">+CME ERROR: &lt;err&gt;</msgblock></entry>
                    </row>
                    <row>
                        <entry>Set command <codeblock><cmdname>AT+MHTTPTERM=&lt;httpid&gt;</cmdname></codeblock></entry>
                        <entry>If succeed: <msgblock id="msgblock_q2z_lf5_pqb">OK</msgblock>
                            If fail: <msgblock id="msgblock_gyb_mf5_pqb">+CME ERROR: &lt;err&gt;</msgblock></entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">Command Description </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                            >This command aborts the current request while preserving the instances, terminating all connections upon execution.  The command does not actively clear the specific header or content data configured in the client instance (these are automatically cleared after successful request). For subsequent requests requiring modification of the specific header or content data, manually clear them by using the relevant command.  </entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">Parameter Description </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2"
                                    ><varname>&lt;httpid&gt;</varname>Client instance id: 0-3.  <fn>MN319/MN319-A/MN316A/MN326A: <varname>&lt;httpid&gt;</varname> parameter range 0-1.  </fn></entry>
                    </row>
                    <row outputclass="has_bgc">
                        <entry namest="c1" nameend="c2">Example </entry>
                    </row>
                    <row>
                        <entry namest="c1" nameend="c2">Terminate current transmission 
                            <msgblock id="codeblock_xy3_pwj_1rb"><cmdname>AT+MHTTPTERM=0</cmdname>
OK</msgblock></entry>
                    </row>
                </tbody>
            </tgroup>
        </table>
        <section id="section_itc_vyt_rrb">
                        <note id="note_x5j_vyt_rrb"
                >ML307B: Since HTTP data reception and AT command processing are asynchronous, after this command is executed to terminate transmission, the data already received by the module but not yet fully processed will continue to be parsed and reported as URCs (e.g., +MHTTPURC or +MHTTPDLFILE) until all in-flight data is processed and then stops completely.  These URCs do not represent data from new requests and this is normal behavior.  </note>
        </section>
    </refbody>
</reference>
