{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "target": "ES2023",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": false
  },
  "files": [
    "types/browser.d.ts",
    "types/boundaries.test.ts",
    "types/ai-boundaries.test.ts",
    "types/review-boundaries.test.ts",
    "lib/ai-provider.js",
    "public/document-store.js",
    "public/xml-source.js",
    "public/oxygen-core.js",
    "public/oxygen-tracking.js",
    "public/author-source.js",
    "public/appearance/theme-preference.js",
    "public/save.js",
    "public/search-core.js",
    "public/snapshot-data.js",
    "public/manual-service.js",
    "types/knowledge-boundaries.test.ts"
  ],
  "include": [
    "public/ai/**/*.js",
    "public/workspace/**/*.js",
    "public/editor/**/*.js",
    "public/review/**/*.js",
    "public/delivery/**/*.js",
    "public/knowledge/**/*.js"
  ]
}
